> ### Name: detect_chars_structure
> ### Title: Detect character structure Detect if values within a character
> ###   variable match at least one of defined patterns
> ### Aliases: detect_chars_structure
> 
> ### ** Examples
> 
> detect_chars_structure(
+   vector = c("ABCD1234", "4567EF", "89GHIJ10"), 
+   patterns = "[:alpha:]{4}" # detect four consecutive alphabetic values
+ )
[1] TRUE
> 
> detect_chars_structure(
+   vector = c("ABCD1234", "4567EF", "89GHIJ10"), 
+   patterns = "[:alpha:]{4}", 
